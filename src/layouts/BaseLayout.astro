---
import '@/styles/fonts.css';
import '@/styles/global.css';
import interFont from '@/assets/fonts/inter-latin-wght-normal.woff2?url';
import bodoniNormal from '@/assets/fonts/bodoni-moda-latin-wght-normal.woff2?url';
import bodoniItalic from '@/assets/fonts/bodoni-moda-latin-wght-italic.woff2?url';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'A luxury real estate experience built with Astro.',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/^\/+/, ''), Astro.site)
  : Astro.url;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = Astro.site
  ? new URL(`${base}/og-estatia.jpg`, Astro.site).href
  : `${base}/og-estatia.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf7f1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Estatia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A contemporary timber-and-glass villa at dusk, framed by mature trees."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href={interFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodoniNormal}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodoniItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
