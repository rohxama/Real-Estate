---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { site } from '@/data/site';
---

<BaseLayout title={site.title} description={site.description}>
  <Header current="" />

  <main id="main-content" class="scaffold">
    <Container>
      <div class="scaffold__inner">
        <Eyebrow>Project setup</Eyebrow>
        <h1 class="display scaffold__title">Foundation <em>ready.</em></h1>
        <p class="body-text scaffold__copy">
          The header and navigation are in place. Page sections follow in the
          next stage.
        </p>
        <Button>Placeholder action</Button>
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .scaffold {
    display: grid;
    min-height: calc(100svh - var(--header-height));
    place-items: center;
  }

  .scaffold__inner {
    padding-block: var(--space-8);
    text-align: center;
  }

  .scaffold__title {
    margin-block: var(--space-4) var(--space-5);
  }

  .scaffold__copy {
    margin: 0 auto var(--space-6);
  }
</style>
