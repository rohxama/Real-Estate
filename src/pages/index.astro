---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
---

<BaseLayout title={site.title} description={site.description}>
  <main id="main-content" class="scaffold">
    <Container class="scaffold__inner">
      <p class="scaffold__eyebrow">Project setup</p>
      <h1 class="scaffold__title">Foundation <em>ready.</em></h1>
      <p class="scaffold__copy">
        Tooling, structure and the production pipeline are configured. Page
        sections will be implemented in the next stage.
      </p>
      <Button>Placeholder action</Button>
    </Container>
  </main>
</BaseLayout>

<style>
  .scaffold {
    display: grid;
    min-height: 100svh;
    place-items: center;
  }

  .scaffold__inner {
    padding-block: var(--space-8);
    text-align: center;
  }

  .scaffold__eyebrow {
    margin-block-end: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .scaffold__title {
    font-size: var(--text-3xl);
  }

  .scaffold__copy {
    max-width: 34rem;
    margin: var(--space-5) auto var(--space-6);
    color: var(--color-muted);
  }
</style>
