---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import About from '@/components/sections/About.astro';
import Collection from '@/components/sections/Collection.astro';
import Cta from '@/components/sections/Cta.astro';
import Faq from '@/components/sections/Faq.astro';
import FeaturedProperties from '@/components/sections/FeaturedProperties.astro';
import Hero from '@/components/sections/Hero.astro';
import Services from '@/components/sections/Services.astro';
import { site } from '@/data/site';
import { buildStructuredData } from '@/data/schema';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ?? Astro.url;
const siteUrl = new URL(`${base}/`, origin).href;
const ogImage = new URL(`${base}/og-estatia.jpg`, origin).href;
const jsonLd = buildStructuredData(siteUrl, ogImage);
---

<BaseLayout
  title={site.title}
  description={site.description}
  jsonLd={jsonLd}
>
  <Header current="" />

  <main id="main-content">
    <Hero />
    <About />
    <FeaturedProperties />
    <Services />
    <Collection />
    <Faq />
    <Cta />
  </main>

  <Footer />
</BaseLayout>
