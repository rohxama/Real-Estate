---
import Container from '@/components/layout/Container.astro';
import BrandMark from '@/components/ui/BrandMark.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { primaryNav } from '@/data/navigation';

interface Props {
  current?: string;
  class?: string;
}

const { current = '/', class: className } = Astro.props;

const base = import.meta.env.BASE_URL;
const links = primaryNav.map((item) => ({
  ...item,
  href: `${base}${item.path}`,
  isCurrent: current === item.path,
}));
---

<header class:list={['site-header', className]} data-site-header>
  <Container>
    <div class="site-header__inner">
      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {
            links.map((item) => (
              <li>
                <a
                  class="site-nav__link"
                  href={item.href}
                  aria-current={item.isCurrent ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="brand" href={base} aria-label="Estatia — home">
        <BrandMark size={27} />
        <span class="brand__wordmark">estatia</span>
      </a>

      <div class="site-header__actions">
        <div class="site-header__cta">
          <Button href={`${base}#contact`} size="xs">
            Contact us
            <Icon slot="trailing" name="arrow-right" size={13} />
          </Button>
        </div>

        <details class="mobile-nav" data-mobile-nav>
          <summary
            class="mobile-nav__toggle"
            aria-label="Open menu"
            data-nav-toggle
          >
            <span class="mobile-nav__bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </summary>

          <div class="mobile-nav__panel">
            <Container>
              <div class="mobile-nav__inner">
                <nav aria-label="Mobile primary">
                  <ul class="mobile-nav__list">
                    {
                      links.map((item) => (
                        <li>
                          <a
                            class="mobile-nav__link"
                            href={item.href}
                            aria-current={item.isCurrent ? 'page' : undefined}
                          >
                            {item.label}
                            <Icon name="arrow-up-right" size={14} />
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </nav>

                <div class="mobile-nav__cta">
                  <Button href={`${base}#contact`} size="xs">
                    Contact us
                    <Icon slot="trailing" name="arrow-right" size={13} />
                  </Button>
                </div>
              </div>
            </Container>
          </div>
        </details>
      </div>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    min-height: var(--header-height);
    background-color: transparent;
    color: var(--color-ink);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  /* Left navigation ------------------------------------------------------ */
  .site-nav {
    grid-column: 1;
    justify-self: start;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2vw, 1.75rem); /* 20 → 28px */
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-ink-soft);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background-color: currentColor;
    opacity: 0.55;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  /* Centred brand lockup -------------------------------------------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    grid-column: 2;
    justify-self: center;
    gap: 0.65rem;
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    color: var(--color-accent);
  }

  .brand__wordmark {
    margin-inline-end: -0.18em; /* optical centring for trailing tracking */
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--weight-regular);
    line-height: var(--leading-none);
    letter-spacing: 0.18em;
    text-transform: lowercase;
  }

  /* Right actions --------------------------------------------------------- */
  .site-header__actions {
    display: flex;
    align-items: center;
    grid-column: 3;
    justify-self: end;
    gap: var(--space-2);
  }

  .site-header__cta {
    white-space: nowrap;
  }

  /* Mobile disclosure ------------------------------------------------------ */
  .mobile-nav {
    display: none;
  }

  .mobile-nav__toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .mobile-nav__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__toggle:hover {
    border-color: var(--color-ink);
    color: var(--color-accent);
  }

  .mobile-nav__bars {
    display: grid;
    gap: 4px;
    width: 14px;
  }

  .mobile-nav__bars span {
    display: block;
    height: 1px;
    background-color: currentColor;
    transition:
      transform var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-nav[open] .mobile-nav__bars span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .mobile-nav[open] .mobile-nav__bars span:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav[open] .mobile-nav__bars span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile-nav__panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    display: none;
    padding-block: var(--space-3) var(--space-6);
    border-block-start: 1px solid var(--color-line);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-0.5rem);
  }

  .mobile-nav[open] .mobile-nav__panel {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav__panel {
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        display var(--duration-base) allow-discrete;
    }

    @starting-style {
      .mobile-nav[open] .mobile-nav__panel {
        opacity: 0;
        transform: translateY(-0.5rem);
      }
    }
  }

  .mobile-nav__inner {
    display: grid;
    gap: var(--space-5);
  }

  .mobile-nav__list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .mobile-nav__link :global(.icon) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav__link:hover :global(.icon) {
      transform: translate(2px, -2px);
    }
  }

  .mobile-nav__link:hover,
  .mobile-nav__link[aria-current="page"] {
    color: var(--color-accent);
  }

  .mobile-nav__cta {
    justify-self: start;
  }

  @media (min-width: 48.0625rem) and (max-width: 60rem) {
    .site-nav__list {
      gap: 0.75rem;
    }

    .site-nav__link {
      font-size: var(--text-2xs);
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 48rem) {
    .site-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .site-header__cta {
      display: none;
    }

    .brand__wordmark {
      font-size: 1.25rem;
    }
  }
</style>
