---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'main';
  width?: 'default' | 'narrow' | 'wide' | 'flush';
  class?: string;
}

const { as: Tag = 'div', width = 'default', class: className } = Astro.props;
---

<Tag
  class:list={[
    'container',
    width !== 'default' && `container--${width}`,
    className,
  ]}
>
  <slot />
</Tag>
