---
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="16"
    cy="16"
    r="14.25"
    stroke="currentColor"
    stroke-width="0.8"
    opacity="0.55"
  />
  <path
    d="M16 5.5c4.55 0 8.25 3.7 8.25 8.25S20.55 22 16 22"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
  />
  <path
    d="M16 26.5c-4.55 0-8.25-3.7-8.25-8.25S11.45 10 16 10"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
  />
  <path
    d="M16 10.75c2.1 0 3.8 1.7 3.8 3.8s-1.7 3.8-3.8 3.8"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
  />
  <path
    d="M16 21.25c-2.1 0-3.8-1.7-3.8-3.8s1.7-3.8 3.8-3.8"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
  />
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    color: var(--color-accent);
  }
</style>
