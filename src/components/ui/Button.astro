---
interface Props {
  variant?: 'primary' | 'outline' | 'inverse';
  size?: 'xs' | 'sm' | 'md';
  href?: string;
  type?: 'button' | 'submit';
  revealDelay?: number;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  revealDelay,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  data-reveal={revealDelay === undefined ? undefined : ''}
  style={revealDelay === undefined ? undefined : `--reveal-delay: ${revealDelay}ms`}
>
  <slot name="icon" />
  <span class="btn__label"><slot /></span>
  <slot name="trailing" />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn :global(.icon) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn:hover :global(.icon) {
      transform: translateX(2px);
    }

    .btn:active {
      transform: translateY(1px);
    }
  }

  .btn--md {
    padding: 0.9rem 1.5rem;
  }

  .btn--sm {
    padding: 0.65rem 1.1rem;
    font-size: var(--text-2xs);
  }

  .btn--xs {
    padding: 0.75rem 1.25rem;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-button);
  }

  .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn--primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn--outline {
    border-color: var(--color-line);
    color: var(--color-ink);
  }

  .btn--outline:hover {
    border-color: var(--color-ink);
    background-color: var(--color-surface);
  }

  .btn--inverse {
    background-color: var(--color-on-accent);
    color: var(--color-accent);
  }

  .btn--inverse:hover {
    background-color: var(--color-surface-bright);
  }

  .btn__label {
    display: inline-block;
  }
</style>
