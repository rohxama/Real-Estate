---
import { Picture } from 'astro:assets';
import Container from '@/components/layout/Container.astro';
import HeroSearch from '@/components/sections/HeroSearch.astro';
import heroEstate from '@/assets/images/hero/hero-estate.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <div class="hero__intro">
      <h1 class="display hero__title" id="hero-title">
        <span class="hero__title-line">Find Your Dream</span>
        <em class="hero__title-line">Luxury Home</em>
      </h1>

      <div class="hero__meta">
        <p class="hero__proof">
          <span class="hero__avatars" aria-hidden="true">
            <span class="hero__avatar">A</span>
            <span class="hero__avatar">M</span>
            <span class="hero__avatar">R</span>
          </span>
          <span class="hero__proof-value">+50K</span>
          <span class="visually-hidden">happy clients</span>
        </p>

        <p class="hero__copy">
          Not just a home, but a refined intelligent sanctuary—your AI
          co-designer crafting a residence that evolves seamlessly with your
          lifestyle and vision every day.
        </p>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__media">
        <Picture
          src={heroEstate}
          alt="Modern cream-toned villa with rounded cantilevered balconies, warm LED strip lighting along each slab edge, vertical timber screens and floor-to-ceiling glazing."
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 640, 720, 960, 1280, 1600, 2000]}
          sizes="(max-width: 85rem) 92vw, 1360px"
          quality={72}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </figure>

    <div class="hero__search-shell">
      <HeroSearch />
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 4.5vw, 4rem) clamp(4rem, 6vw, 5.5rem);
  }

  /* Text band ------------------------------------------------------------- */
  .hero__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 0.95fr);
    align-items: end;
    gap: clamp(2rem, 7.5vw, 7rem);
    padding-block-end: clamp(2rem, 3vw, 2.5rem);
  }

  .hero__title {
    margin: 0;
    /* Warm cocoa, matching the supplied hero mock rather than the site's
       near-black ink; the italic line steps one tone lighter. */
    color: #5f3b2f;
    /* Scales with the viewport so the two-line lockup keeps the reference
       proportion between 1440 and tablet widths. */
    font-size: clamp(3rem, 6.6vw, 6rem);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title em {
    font-style: italic;
    font-weight: var(--weight-regular);
    color: #8d6a55;
  }

  .hero__meta {
    padding-block-end: 0.35rem;
  }

  /* Avatar cluster + client count ----------------------------------------- */
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .hero__avatars {
    display: flex;
    align-items: center;
  }

  .hero__avatar {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background-color: var(--color-ink-soft);
    color: var(--color-on-accent);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero__avatar:nth-child(1) {
    background-color: var(--color-accent);
  }

  .hero__avatar:nth-child(2) {
    background-color: #8c6a4f;
  }

  .hero__avatar + .hero__avatar {
    margin-inline-start: -0.55rem;
  }

  .hero__proof-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-regular);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .hero__copy {
    max-width: 52ch;
    margin-block-start: 1rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /* Image ----------------------------------------------------------------- */
  .hero__figure {
    margin: 0;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio-hero);
    border-radius: var(--radius-xl);
    /* Matches the cut-out sky in the hero photograph so the rounded card
       reads as one continuous surface while the image loads. */
    background-color: #f3eee4;
    isolation: isolate;
  }

  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }

  /* Floating search widget ------------------------------------------------ */
  .hero__search-shell {
    position: relative;
    z-index: 2;
    padding-inline: clamp(0rem, 3vw, 2.5rem);
    margin-block-start: clamp(-5rem, -4.5vw, -3.75rem);
  }

  /* Entrance -------------------------------------------------------------- */
  /* Only the typography moves on load. The hero photograph is left untouched
     so its LCP paint is never delayed, and the title uses translate rather
     than opacity so the first paint already contains the headline. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title-line {
      animation: hero-line-in var(--duration-slow) var(--ease-out) both;
    }

    .hero__title-line:nth-child(2) {
      animation-delay: 90ms;
    }

    .hero__meta {
      animation: hero-meta-in var(--duration-slow) var(--ease-out) 160ms both;
    }
  }

  @keyframes hero-line-in {
    from {
      translate: 0 0.75rem;
    }

    to {
      translate: 0 0;
    }
  }

  @keyframes hero-meta-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Responsive ------------------------------------------------------------ */
  @media (max-width: 64rem) {
    .hero__intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 2rem;
    }

    .hero__meta {
      max-width: 34rem;
      padding-block-end: 0;
    }
  }

  @media (max-width: 48rem) {
    .hero__media {
      aspect-ratio: 1.45 / 1;
    }

    .hero__search-shell {
      padding-inline: 0;
    }
  }

  @media (max-width: 30rem) {
    .hero__title {
      font-size: clamp(2.5rem, 11vw, 3.25rem);
    }

    .hero__media {
      aspect-ratio: 1.2 / 1;
    }
  }

  @media (max-width: 20rem) {
    .hero__title {
      font-size: 2.1rem;
    }
  }
</style>
