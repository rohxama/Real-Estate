---
import { Picture } from 'astro:assets';
import Container from '@/components/layout/Container.astro';
import HeroSearch from '@/components/sections/HeroSearch.astro';
import Icon from '@/components/ui/Icon.astro';
import heroVilla from '@/assets/images/hero/hero-villa.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <div class="hero__intro">
      <h1 class="display hero__title" id="hero-title">
        <span class="hero__title-line">Find Your Dream</span>
        <em class="hero__title-line">Luxury Home</em>
      </h1>

      <div class="hero__meta">
        <p class="hero__stat">
          <Icon name="users" size={18} />
          <span class="hero__stat-value">4.5K+</span>
          <span class="hero__stat-label">Happy clients</span>
        </p>

        <p class="hero__copy">
          Discover the exceptional — a curated collection of architectural
          homes where craftsmanship, natural light and landscape come together
          in quiet, enduring luxury.
        </p>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__media">
        <Picture
          src={heroVilla}
          alt="Contemporary timber-and-glass villa glowing at dusk, framed by mature trees and a lawn."
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1600, 2000, 2560, 3200]}
          sizes="(max-width: 48rem) 100vw, (max-width: 85rem) 92vw, 1360px"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </figure>

    <div class="hero__search-shell">
      <HeroSearch />
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 4.5vw, 4rem) clamp(4rem, 6vw, 5.5rem);
  }

  /* Text band ------------------------------------------------------------- */
  .hero__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 0.95fr);
    align-items: end;
    gap: clamp(2rem, 7.5vw, 7rem);
    padding-block-end: clamp(2rem, 3vw, 2.5rem);
  }

  .hero__title {
    margin: 0;
    /* Scales with the viewport so the two-line lockup keeps the reference
       proportion between 1440 and tablet widths. */
    font-size: clamp(3rem, 6.6vw, 6rem);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title em {
    font-style: italic;
    font-weight: var(--weight-regular);
  }

  .hero__meta {
    padding-block-end: 0.35rem;
  }

  .hero__stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-accent);
  }

  .hero__stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-regular);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .hero__stat-label {
    margin-block-start: 0.15rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__copy {
    max-width: 52ch;
    margin-block-start: 1rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /* Image ----------------------------------------------------------------- */
  .hero__figure {
    margin: 0;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio-hero);
    border-radius: var(--radius-xl);
    background-color: var(--color-img-tint);
    isolation: isolate;
  }

  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      120% 145% at 50% 45%,
      rgba(20, 14, 10, 0) 58%,
      rgba(20, 14, 10, 0.24) 100%
    );
    pointer-events: none;
  }

  /* Floating search widget ------------------------------------------------ */
  .hero__search-shell {
    position: relative;
    z-index: 2;
    padding-inline: clamp(0rem, 3vw, 2.5rem);
    margin-block-start: clamp(-3.5rem, -3.5vw, -2.75rem);
  }

  /* Responsive ------------------------------------------------------------ */
  @media (max-width: 64rem) {
    .hero__intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 2rem;
    }

    .hero__meta {
      max-width: 34rem;
      padding-block-end: 0;
    }
  }

  @media (max-width: 48rem) {
    .hero__media {
      aspect-ratio: 1.45 / 1;
    }

    .hero__search-shell {
      padding-inline: 0;
    }
  }

  @media (max-width: 30rem) {
    .hero__title {
      font-size: clamp(2.5rem, 11vw, 3.25rem);
    }

    .hero__media {
      aspect-ratio: 1.2 / 1;
    }
  }

  @media (max-width: 20rem) {
    .hero__title {
      font-size: 2.1rem;
    }
  }
</style>
