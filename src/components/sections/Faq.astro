---
import Container from '@/components/layout/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { faqs } from '@/data/faqs';
---

<section class="faq section" aria-labelledby="faq-title">
  <Container>
    <div class="faq__layout">
      <SectionHeading
        id="faq-title"
        size="sm"
        line1="Frequently"
        line2="Asked Question?"
      />

      <div class="faq__list" data-reveal style="--reveal-delay: 80ms">
        {
          faqs.map((faq, index) => (
            <details
              class="faq-item"
              name="faq"
              open={index === 0 ? true : undefined}
            >
              <summary class="faq-item__summary">
                <span class="faq-item__question">{faq.question}</span>
                <span class="faq-item__control" aria-hidden="true">
                  <Icon class="faq-item__plus" name="plus" size={13} />
                  <Icon class="faq-item__minus" name="minus" size={13} />
                </span>
              </summary>

              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .faq__list {
    interpolate-size: allow-keywords;
  }

  .faq-item {
    /* Padding is present in every state so the question text keeps the same
       left edge when a row opens; only the fill changes. */
    padding-inline: clamp(1rem, 1.8vw, 1.5rem);
    border-block-start: 1px solid var(--color-line);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .faq-item:last-child {
    border-block-end: 1px solid var(--color-line);
  }

  .faq-item[open] {
    border-color: transparent;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-deep);
    color: var(--color-on-accent);
  }

  .faq-item__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: 1.05rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  .faq-item__question {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-out);
  }

  .faq-item[open] .faq-item__question {
    color: var(--color-on-accent);
  }

  .faq-item:not([open]) .faq-item__summary:hover .faq-item__question {
    color: var(--color-accent);
  }

  .faq-item__control {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-ink);
    transition:
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .faq-item__control :global(.icon) {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .faq-item[open] .faq-item__control {
    border-color: rgba(251, 246, 236, 0.32);
    color: var(--color-on-accent);
  }

  .faq-item[open] :global(.faq-item__plus) {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }

  .faq-item:not([open]) :global(.faq-item__minus) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }

  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size var(--duration-slow) var(--ease-out);
  }

  .faq-item[open]::details-content {
    block-size: auto;
  }

  .faq-item__answer {
    padding-block-end: 1.35rem;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity var(--duration-base) var(--ease-out) 60ms,
      transform var(--duration-base) var(--ease-out) 60ms;
  }

  .faq-item[open] .faq-item__answer {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-item__answer p {
    max-width: 58ch;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: rgba(251, 246, 236, 0.74);
  }

  @media (max-width: 64rem) {
    .faq__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 30rem) {
    .faq-item__question {
      font-size: var(--text-sm);
    }
  }
</style>
