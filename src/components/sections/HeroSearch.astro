---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

const base = import.meta.env.BASE_URL;

const fields = [
  {
    name: 'location',
    label: 'Location',
    options: [
      'Any location',
      'New York',
      'Los Angeles',
      'Miami',
      'London',
    ],
  },
  {
    name: 'type',
    label: 'Type',
    options: ['Any type', 'Villa', 'House', 'Apartment', 'Estate'],
  },
  {
    name: 'property',
    label: 'Property',
    options: [
      'Any property',
      '3+ bedrooms',
      '4+ bedrooms',
      '5+ bedrooms',
    ],
  },
  {
    name: 'price',
    label: 'Price',
    options: [
      'Any price',
      'Under $1M',
      '$1M – $3M',
      '$3M – $5M',
      '$5M+',
    ],
  },
] as const;
---

<form
  class="search"
  role="search"
  aria-label="Property search"
  action={`${base}#properties`}
  method="get"
>
  <fieldset class="search__tabs">
    <legend class="visually-hidden">Listing type</legend>

    <label class="search__tab">
      <input type="radio" name="listing" value="sale" checked />
      <span class="search__tab-label">For Sale</span>
    </label>

    <label class="search__tab">
      <input type="radio" name="listing" value="rent" />
      <span class="search__tab-label">For Rent</span>
    </label>
  </fieldset>

  <div class="search__fields">
    {
      fields.map((field) => (
        <label class="search__field">
          <span class="search__field-label">{field.label}</span>
          <span class="search__field-control">
            <select name={field.name}>
              {field.options.map((option, index) => (
                <option value={index === 0 ? '' : option} selected={index === 0}>
                  {option}
                </option>
              ))}
            </select>
            <Icon class="search__chevron" name="chevron-down" size={14} />
          </span>
        </label>
      ))
    }
  </div>

  <Button class="search__submit" type="submit" size="md">
    Search now
    <Icon slot="trailing" name="arrow-right" size={14} />
  </Button>
</form>

<style>
  .search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 2vw, 2rem);
    min-height: 6rem;
    padding: 1.25rem;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-float);
  }

  /* Listing-type tabs ----------------------------------------------------- */
  .search__tabs {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0 clamp(1rem, 1.6vw, 1.5rem) 0 0;
    margin: 0;
    border: 0;
    border-inline-end: 1px solid var(--color-line);
  }

  .search__tab {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .search__tab input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .search__tab-label {
    position: relative;
    display: inline-block;
    padding-block-end: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .search__tab-label::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    width: 1.15rem;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .search__tab input:checked + .search__tab-label {
    color: var(--color-ink);
  }

  .search__tab input:checked + .search__tab-label::after {
    transform: scaleX(1);
  }

  .search__tab input:focus-visible + .search__tab-label {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .search__tab:hover .search__tab-label {
    color: var(--color-ink);
  }

  /* Filter fields --------------------------------------------------------- */
  .search__fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
  }

  .search__field {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding-inline-end: clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .search__field + .search__field {
    padding-inline-start: clamp(0.75rem, 1.4vw, 1.25rem);
    border-inline-start: 1px solid var(--color-line);
  }

  .search__field-label {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .search__field:hover .search__field-label,
  .search__field:focus-within .search__field-label {
    color: var(--color-ink-soft);
  }

  .search__field-control {
    position: relative;
    display: block;
    min-width: 0;
  }

  .search__field select {
    width: 100%;
    padding: 0 1.2rem 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    appearance: none;
  }

  .search__field select:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  :global(.search__chevron) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    color: var(--color-muted);
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .search__field:hover :global(.search__chevron),
  .search__field:focus-within :global(.search__chevron) {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .search__field:focus-within :global(.search__chevron) {
      transform: translateY(-50%) rotate(180deg);
    }
  }

  /* Submit ---------------------------------------------------------------- */
  .search :global(.search__submit) {
    min-height: 3.5rem;
    padding-inline: 1.5rem;
  }

  .search :global(.search__submit .icon) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .search :global(.search__submit:hover .icon) {
      transform: translateX(3px);
    }
  }

  /* Tablet ---------------------------------------------------------------- */
  @media (max-width: 64rem) {
    .search {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      min-height: 0;
    }

    .search__tabs {
      flex-direction: row;
      gap: 1.75rem;
      padding: 0 0 0.85rem;
      border-inline-end: 0;
      border-block-end: 1px solid var(--color-line);
    }

    .search__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 0;
    }

    .search__field + .search__field {
      padding-inline-start: 0;
      border-inline-start: 0;
    }

    .search__field:nth-child(even) {
      padding-inline-start: 1.25rem;
      border-inline-start: 1px solid var(--color-line);
    }

    .search__field:nth-child(n + 3) {
      padding-block-start: 1rem;
      border-block-start: 1px solid var(--color-line);
    }

    .search :global(.search__submit) {
      min-height: 3.25rem;
    }
  }

  @media (max-width: 30rem) {
    .search__field:nth-child(even) {
      padding-inline-start: 1rem;
    }
  }
</style>
