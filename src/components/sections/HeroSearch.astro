---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

const base = import.meta.env.BASE_URL;

const types = [
  { value: 'residential', label: 'Residential', checked: true },
  { value: 'apartment', label: 'Apartment' },
  { value: 'commercial', label: 'Commercial' },
];

const fields = [
  {
    name: 'bedrooms',
    label: 'Bedroom',
    options: ['Any', '1+', '2+', '3+', '4+', '5+'],
  },
  {
    name: 'country',
    label: 'Country',
    options: [
      'Any',
      'United Kingdom',
      'United States',
      'United Arab Emirates',
      'France',
      'Italy',
      'Spain',
    ],
  },
  {
    name: 'currency',
    label: 'Currency',
    options: ['USD', 'GBP', 'EUR', 'AED'],
  },
  {
    name: 'starting_from',
    label: 'Starting From',
    options: ['Any', '250,000', '500,000', '1,000,000', '2,000,000', '5,000,000'],
  },
] as const;
---

<form
  class="search"
  role="search"
  aria-label="Property search"
  action={`${base}#properties`}
  method="get"
>
  <fieldset class="search__tabs">
    <legend class="visually-hidden">Property type</legend>

    {
      types.map((type) => (
        <label class="search__tab">
          <input
            type="radio"
            name="listing"
            value={type.value}
            checked={type.checked}
          />
          <span class="search__tab-label">{type.label}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="search__bar">
    <div class="search__fields">
      {
        fields.map((field) => (
          <label class="search__field">
            <span class="search__field-label" id={`${field.name}-label`}>
              {field.label}
            </span>
            <span class="search__field-control">
              <select name={field.name} aria-labelledby={`${field.name}-label`}>
                {field.options.map((option, index) => (
                  <option
                    value={option === 'Any' ? '' : option}
                    selected={index === 0}
                  >
                    {option}
                  </option>
                ))}
              </select>
              <Icon class="search__chevron" name="chevron-down" size={13} />
            </span>
          </label>
        ))
      }
    </div>

    <Button class="search__submit" type="submit" size="md">
      Search Properties
      <Icon slot="trailing" name="arrow-right" size={14} />
    </Button>
  </div>
</form>

<style>
  .search {
    display: grid;
    gap: 0.75rem;
    padding: 0.8rem 1rem 1rem;
    background-color: var(--color-surface);
    /* Softer than a pill: the client asked for a squarer card than the
       original 24 px, so the panel uses the small-radius token. */
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-float);
  }

  /* Property-type tabs ---------------------------------------------------- */
  .search__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0 0 0.7rem;
    margin: 0;
    border: 0;
    border-block-end: 1px solid var(--color-line);
  }

  .search__tab {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .search__tab input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .search__tab-label {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .search__tab:hover .search__tab-label {
    color: var(--color-ink);
  }

  .search__tab input:checked + .search__tab-label {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .search__tab input:focus-visible + .search__tab-label {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Filter fields --------------------------------------------------------- */
  .search__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
  }

  .search__fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
  }

  .search__field {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    padding-inline: clamp(0.75rem, 1.5vw, 1.35rem);
    border-inline-start: 1px solid var(--color-line);
  }

  .search__field:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .search__field-label {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .search__field:hover .search__field-label,
  .search__field:focus-within .search__field-label {
    color: var(--color-ink-soft);
  }

  .search__field-control {
    position: relative;
    display: block;
    min-width: 0;
  }

  .search__field select {
    width: 100%;
    padding: 0 1.2rem 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    appearance: none;
  }

  .search__field select:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  :global(.search__chevron) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    color: var(--color-muted);
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .search__field:hover :global(.search__chevron),
  .search__field:focus-within :global(.search__chevron) {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .search__field:focus-within :global(.search__chevron) {
      transform: translateY(-50%) rotate(180deg);
    }
  }

  /* Submit ---------------------------------------------------------------- */
  .search :global(.search__submit) {
    min-height: 2.9rem;
    padding-inline: 1.35rem;
  }

  .search :global(.search__submit .icon) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .search :global(.search__submit:hover .icon) {
      transform: translateX(3px);
    }
  }

  /* Tablet ---------------------------------------------------------------- */
  @media (max-width: 64rem) {
    .search {
      padding: 0.85rem 1rem 1.1rem;
    }

    .search__bar {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
    }

    .search__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1rem;
    }

    .search__field {
      padding-inline: 0 1rem;
      border-inline-start: 0;
    }

    .search__field:nth-child(even) {
      padding-inline: 1rem 0;
      border-inline-start: 1px solid var(--color-line);
    }

    .search__field:nth-child(n + 3) {
      padding-block-start: 0.9rem;
      border-block-start: 1px solid var(--color-line);
    }

    .search :global(.search__submit) {
      width: 100%;
      min-height: 3rem;
    }
  }

  @media (max-width: 30rem) {
    .search__tabs {
      gap: 0.15rem;
    }

    .search__tab-label {
      padding-inline: 0.6rem;
    }
  }

  /* Touch targets: keep the visuals but expand the radio tabs to 44 px and
     give the native selects a full-height tap area. */
  @media (pointer: coarse) and (max-width: 64rem) {
    .search__tab-label {
      padding-block: 0.7rem;
    }

    .search__field select {
      min-height: 2.75rem;
    }
  }
</style>
